package analytics

import (
	"encoding/json"
	"fmt"
	"net/http"
	"net/url"
	"os"
	"strings"
	"time"
)

const apiBase = "https://www.googleapis.com/youtube/v3"

// ══════════════════════════════════════════════════════
// 📊 YouTube Analytics — تقرير: أي عنوان نجح؟ أيه فشل؟
// يحتاج: YT_REFRESH_TOKEN في secrets/yt_refresh_token
// (يُنشأ مرة واحدة عبر تفويض — انظر الأسفل)
// ═══════════════════════════════════════════════════════

type Video struct {
	ID    string `json:"videoId"`
	Title string
	Stats struct {
		Views int    `json:"viewCount"`
		Likes int    `json:"likeCount"`
	} `json:"statistics"`
}

// Report: تقرير آخر 20 فيديو + حفظ القرار في data/analytics.json
func Report() {
	videos := fetchUploads()
	if videos == nil {
		fmt.Println("📊 analytics: بلا refresh token — تخطي (اختياري)")
		return
	}

	best, worst := videos[0], videos[0]
	var b strings.Builder
	b.WriteString("\n═════ 📊 تقرير الأداء — آخر 20 فيديو ═════\n")
	for _, v := range videos {
		if v.Stats.Views > best.Stats.Views {
			best = v
		}
		if v.Stats.Views < worst.Stats.Views {
			worst = v
		}
		b.WriteString(fmt.Sprintf("  ▫️ [%5d مشاهدة 👍%d] %s\n", v.Stats.Views, v.Stats.Likes, cut(v.Title)))
	}
	b.WriteString(fmt.Sprintf("\n🥇 الأفضل: %s (%d مشاهدة)\n", best.Title, best.Stats.Views))
	b.WriteString(fmt.Sprintf("📉 الأضعف: %s (%d)\n", worst.Title, worst.Stats.Views))
	b.WriteString("💡 القرار: قوالب النوع الناجح تتضاعف في seo.go\n")
	fmt.Print(b.String())

	os.MkdirAll("data", 0755)
	json, _ := json.MarshalIndent(map[string]interface{}{
		"best": best.Title, "best_views": best.Stats.Views,
		"worst": worst.Title, "worst_views": worst.Stats.Views,
		"updated": time.Now().Format("2006-01-02"),
	}, "", "  ")
	os.WriteFile("data/analytics.json", json, 0644)
}

// fetchUploads: آخر 20 فيديو من قناتك عبر OAuth
func fetchUploads() []Video {
	access, ok := getAccessToken()
	if !ok {
		return nil
	}
	client := &http.Client{}
	get := func(u string, out interface{}) bool {
		req, _ := http.NewRequest("GET", u, nil)
		req.Header.Set("Authorization", "Bearer "+access)
		resp, err := client.Do(req)
		if err != nil {
			return false
		}
		defer resp.Body.Close()
		return json.NewDecoder(resp.Body).Decode(out) == nil
	}

	// 1) قناتي
	var ch struct {
		Items []struct {
			ContentDetails struct {
				RelatedPlaylists struct {
					Uploads string `json:"uploads"`
				} `json:"relatedPlaylists"`
			} `json:"contentDetails"`
		} `json:"items"`
	}
	if !get(apiBase+"/channels?part=contentDetails&mine=true", &ch) || len(ch.Items) == 0 {
		return nil
	}
	uploads := ch.Items[0].ContentDetails.RelatedPlaylists.Uploads

	// 2) آخر 20 فيديو
	var pl struct {
		Items []struct {
			ContentDetails struct {
				VideoID string `json:"videoId"`
			} `json:"contentDetails"`
		} `json:"items"`
	}
	if !get(fmt.Sprintf(apiBase+"/playlistItems?part=contentDetails&maxResults=20&playlistId=%s", uploads), &pl) {
		return nil
	}

	// 3) إحصائياتهم
	var out []Video
	for _, it := range pl.Items {
		var vid struct {
			Items []struct {
				Snippet struct {
					Title string `json:"title"`
				} `json:"snippet"`
				Statistics struct {
					Views int    `json:"viewCount"`
					Likes int    `json:"likeCount"`
				} `json:"statistics"`
			} `json:"items"`
		}
		if !get(fmt.Sprintf(apiBase+"/videos?part=snippet,statistics&id=%s", it.ContentDetails.VideoID), &vid) || len(vid.Items) == 0 {
			continue
		}
		out = append(out, Video{
			ID:    it.ContentDetails.VideoID,
			Title: vid.Items[0].Snippet.Title,
		})
		out[len(out)-1].Stats.Views = vid.Items[0].Statistics.Views
		out[len(out)-1].Stats.Likes = vid.Items[0].Statistics.Likes
	}
	if len(out) == 0 {
		return nil
	}
	return out
}

// getAccessToken: refresh token → access token
func getAccessToken() (string, bool) {
	rt := readSecret("secrets/yt_refresh_token")
	if rt == "" {
		return "", false
	}
	cid := readSecret("secrets/yt_client_id")
	csec := readSecret("secrets/yt_client_secret")
	if cid == "" || csec == "" {
		return "", false
	}
	resp, err := http.PostForm("https://oauth2.googleapis.com/token",
		url.Values{
			"client_id":     {cid},
			"client_secret": {csec},
			"refresh_token": {rt},
			"grant_type":    {"refresh_token"},
		})
	if err != nil {
		return "", false
	}
	defer resp.Body.Close()
	var tok struct {
		AccessToken string `json:"access_token"`
	}
	if json.NewDecoder(resp.Body).Decode(&tok) != nil || tok.AccessToken == "" {
		return "", false
	}
	return tok.AccessToken, true
}

func readSecret(p string) string {
	b, err := os.ReadFile(p)
	if err != nil {
		return ""
	}
	return strings.TrimSpace(string(b))
}

func cut(s string) string {
	r := []rune(s)
	if len(r) > 55 {
		return string(r[:55]) + "..."
	}
	return s
}
